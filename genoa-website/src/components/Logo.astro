---
import { path } from '../lib/routes';
import type { Lang } from '../content/types';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<a class="logo" href={path(lang)} aria-label={lang === 'ar' ? 'Genoa Systems — الصفحة الرئيسية' : 'Genoa Systems — home'}>
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="10" fill="#1746a2" />
    <path d="M28.5 14.2A9.6 9.6 0 1 0 29.6 22H20.5" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="30.5" cy="30.5" r="3.2" fill="#2bb3a3" />
  </svg>
  <span>Genoa Systems</span>
</a>
