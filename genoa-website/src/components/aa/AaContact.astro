---
/**
 * The office's phone numbers by purpose (accounting; technical consulting and IT services), each as its own tile of
 * tel: buttons, then its address, optional WhatsApp, and Facebook / Instagram.
 */
import type { Lang } from '../../content/types';
import { aaContactBlock, aaOffice, aaPhoneGroups } from '../../content/academic-accountant';
import Icon from '../Icon.astro';
import AaSocial from './AaSocial.astro';
import AaCallButtons from './AaCallButtons.astro';
interface Props { lang: Lang; headingId?: string; }
const { lang, headingId = 'aa-contact' } = Astro.props;
const c = aaContactBlock[lang];
---
<section class="aa-contact" aria-labelledby={headingId} data-reveal>
  <h2 id={headingId}>{c.heading}</h2>
  <dl class="aa-contact-list">
    {aaPhoneGroups.map((g) => (
      <div class="aa-contact-phones" data-group={g.id}>
        <dt><span class="aa-contact-icon"><Icon name={g.icon} /></span>{c.phoneGroups[g.id]}</dt>
        <dd><AaCallButtons lang={lang} phones={g.phones} /></dd>
      </div>
    ))}
    <div>
      <dt><Icon name="pin" />{c.addressLabel}</dt>
      <dd>{aaOffice.address[lang].full}</dd>
    </div>
    {aaOffice.whatsapp ? (
      <div>
        <dt><Icon name="whatsapp" />WhatsApp</dt>
        <dd><a href={`https://wa.me/${aaOffice.whatsapp}`} rel="noopener" target="_blank">{c.whatsapp}</a></dd>
      </div>
    ) : (
      <Fragment set:html="<!-- TODO(Zain): confirm which number is on WhatsApp (aaOffice.whatsapp, src/content/academic-accountant.ts); a wa.me link appears here then. -->" />
    )}
    <div>
      <dt>{c.followLabel}</dt>
      <dd><AaSocial lang={lang} /></dd>
    </div>
  </dl>
</section>
