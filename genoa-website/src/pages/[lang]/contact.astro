---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ErrorMsg from '../../components/ErrorMsg.astro';
import { LANGS, type Lang } from '../../content/types';
import { contact, governorates } from '../../content/pages';
import { t } from '../../i18n/ui';
import { abs, path } from '../../lib/routes';
import { pageGraph } from '../../lib/seo';
import { site, whatsappLink } from '../../config/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = contact[lang];
const F = c.fields;
const crumbs = [
  { name: t('home', lang), href: path(lang) },
  { name: t('bookDemo', lang), href: path(lang, 'contact') },
];
const og = `/og/og-home-${lang}.png`;
const jsonld = pageGraph({
  lang,
  pathname: path(lang, 'contact'),
  title: c.title,
  description: c.description,
  pageType: 'ContactPage',
  breadcrumbs: crumbs,
  about: ['companies', 'government'],
  image: abs(og),
});
const mode = site.formEndpoint ? 'endpoint' : 'whatsapp';
---
<BaseLayout lang={lang} title={c.title} description={c.description} ogImage={og} jsonld={jsonld}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs lang={lang} items={crumbs} />
      <h1>{c.h1}</h1>
      <p class="answer">{c.answer}</p>
      <div class="btn-row">
        <a class="btn btn-wa" href={whatsappLink(t('whatsappPrefill', lang))} rel="noopener" target="_blank"><Icon name="whatsapp" />{t('whatsapp', lang)}</a>
        <a class="btn btn-ghost" href="#form-heading">{c.formHeading}</a>
      </div>
    </div>
  </section>

  <div class="section">
    <div class="container content-grid">
      <section class="form-card" aria-labelledby="form-heading">
        <h2 id="form-heading">{c.formHeading}</h2>
        <form
          id="demo-form"
          action={site.formEndpoint || `mailto:${site.email}`}
          method="post"
          enctype={site.formEndpoint ? undefined : 'text/plain'}
          data-mode={mode}
          data-wa={site.whatsapp}
          data-intro={c.waMessageIntro}
          data-opening={c.statusOpening}
        >
          <div class="form-grid">
            <div class="field">
              <label for="f-name">{F.name}</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required data-label={F.name} data-error="f-name-error" />
              <ErrorMsg id="f-name-error" text={c.errors.name} />
            </div>
            <div class="field">
              <label for="f-org">{F.organisation}</label>
              <input id="f-org" name="organisation" type="text" autocomplete="organization" required data-label={F.organisation} data-error="f-org-error" />
              <ErrorMsg id="f-org-error" text={c.errors.organisation} />
            </div>
            <div class="field">
              <label for="f-type">{F.orgType}</label>
              <select id="f-type" name="organisation_type" required data-label={F.orgType} data-error="f-type-error">
                <option value="" disabled selected>{F.orgTypeNone}</option>
                {F.orgTypes.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
              <ErrorMsg id="f-type-error" text={c.errors.orgType} />
            </div>
            <div class="field">
              <label for="f-product">{F.product}</label>
              <select id="f-product" name="product" required data-label={F.product} data-error="f-product-error">
                <option value="" disabled selected>{F.productNone}</option>
                {F.products.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
              <ErrorMsg id="f-product-error" text={c.errors.product} />
            </div>
            <div class="field">
              <label for="f-phone">{F.phone}</label>
              <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required aria-describedby="f-phone-hint" data-label={F.phone} data-error="f-phone-error" />
              <p class="hint" id="f-phone-hint">{F.phoneHint}</p>
              <ErrorMsg id="f-phone-error" text={c.errors.phone} />
            </div>
            <div class="field">
              <label for="f-gov">{F.governorate} <span class="opt">{F.optional}</span></label>
              <select id="f-gov" name="governorate" data-label={F.governorate}>
                <option value="">{F.governorateNone}</option>
                {governorates[lang].map((g) => <option value={g}>{g}</option>)}
              </select>
            </div>
            <div class="field full">
              <label for="f-email">{F.email} <span class="opt">{F.optional}</span></label>
              <input id="f-email" name="email" type="email" autocomplete="email" autocorrect="off" autocapitalize="none" spellcheck="false" dir="ltr" data-label={F.email} data-error="f-email-error" />
              <ErrorMsg id="f-email-error" text={c.errors.email} />
            </div>
            <div class="field full">
              <label for="f-msg">{F.message} <span class="opt">{F.optional}</span></label>
              <textarea id="f-msg" name="message" rows="4" data-label={F.message}></textarea>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="f-hp">Leave empty</label>
              <input id="f-hp" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </div>
          </div>
          <p class="hint" style="margin-top:1rem">{c.privacy}</p>
          <button class="btn btn-primary" type="submit">
            {mode === 'whatsapp' ? <><Icon name="whatsapp" />{c.submitWhatsapp}</> : c.submitEndpoint}
          </button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          <noscript><p class="note">{c.noscript}</p></noscript>
        </form>
      </section>

      <aside>
        <section class="form-card" aria-labelledby="direct-heading">
          <h2 id="direct-heading">{c.directHeading}</h2>
          <p>{c.directBody}</p>
          <div class="btn-row" style="flex-direction:column;margin-top:0.5rem">
            <a class="btn btn-wa" href={whatsappLink(t('whatsappPrefill', lang))} rel="noopener" target="_blank"><Icon name="whatsapp" />{t('whatsapp', lang)}</a>
            <a class="btn btn-ghost" href={`mailto:${site.email}`}><Icon name="mail" /><span class="ltr">{site.email}</span></a>
          </div>
        </section>
        <section style="margin-top:1.5rem" aria-labelledby="next-heading">
          <h2 id="next-heading">{c.nextHeading}</h2>
          <ol>{c.nextSteps.map((s) => <li>{s}</li>)}</ol>
        </section>
      </aside>
    </div>
  </div>

  <script>
    // Field errors (validate-on-leave, :user-invalid): each required or checked field has an error message, linked
    // through data-error, that CSS shows once the field is :user-invalid. This keeps aria-invalid and
    // aria-describedby in step with what is shown, puts the same words in the browser's own message, and reads a
    // new error out once, through one polite live region, when the user leaves the field.
    const form = document.querySelector<HTMLFormElement>('#demo-form');
    if (form) {
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-error]')];
      const errorText = (el: Element) => document.getElementById((el as HTMLElement).dataset.error ?? '');

      // List the error message in aria-describedby only while it is shown: a hidden message referenced there
      // would still be read out.
      const linkError = (el: HTMLElement, shown: boolean) => {
        const id = el.dataset.error;
        if (!id) return;
        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((x) => x && x !== id);
        if (shown) ids.push(id);
        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
        else el.removeAttribute('aria-describedby');
      };

      const announcer = document.createElement('div');
      announcer.setAttribute('aria-live', 'polite');
      announcer.className = 'visually-hidden';
      document.body.append(announcer);
      let announceTimer: number | undefined;
      let announcedField: Element | undefined;
      // Text as a screen reader reads it: the icon's label in, hidden text out.
      const spoken = (node: Element) => {
        const copy = node.cloneNode(true) as Element;
        copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
        copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
        return (copy.textContent || '').replace(/\s+/g, ' ').trim();
      };
      const announce = (el: HTMLInputElement | HTMLSelectElement) => {
        const error = errorText(el);
        if (!error) return;
        const label = el.labels?.[0] ? `${spoken(el.labels[0])}: ` : '';
        clearTimeout(announceTimer);
        announcer.textContent = '';
        announcedField = el;
        // After the screen reader has announced the field that receives focus next.
        announceTimer = window.setTimeout(() => { announcer.textContent = label + spoken(error); }, 500);
      };

      const flagged = new WeakSet<Element>();
      const announced = new WeakSet<Element>();
      const sync = (el: EventTarget | null, withAnnouncement = false) => {
        if (!(el instanceof HTMLInputElement || el instanceof HTMLSelectElement) || !el.dataset.error) return;
        if (el.matches(':user-invalid')) {
          if (withAnnouncement && !announced.has(el)) { announce(el); announced.add(el); }
          el.setAttribute('aria-invalid', 'true');
          linkError(el, true);
          flagged.add(el);
        } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
          el.setAttribute('aria-invalid', 'false');
          linkError(el, false);
          flagged.delete(el);
          announced.delete(el);
          if (announcedField === el) { clearTimeout(announceTimer); announcer.textContent = ''; }
        }
      };

      fields.forEach((el) => sync(el));
      // The browser's own message says the same as the field's error, in the page's language. A new value
      // clears it first (capture phase, before sync below), so the field is checked afresh.
      form.addEventListener('input', (e) => { if (e.target instanceof HTMLInputElement || e.target instanceof HTMLSelectElement) e.target.setCustomValidity(''); }, true);
      form.addEventListener('invalid', (e) => {
        const el = e.target as HTMLInputElement | HTMLSelectElement;
        const error = errorText(el);
        if (error && el.validity.valid === false && !el.validity.customError) el.setCustomValidity(spoken(error));
        // A failed send moves focus to the first invalid field, which reads its error; no announcement needed.
        announced.add(el);
        sync(el);
      }, true);
      form.addEventListener('blur', (e) => sync(e.target, true), true);
      form.addEventListener('change', (e) => sync(e.target, true), true);
      form.addEventListener('input', (e) => { if (e.target instanceof Element && e.target.hasAttribute('aria-invalid')) sync(e.target); });

      // Sending. The browser checks the fields first: 'submit' only fires once they are all valid.
      const status = document.getElementById('form-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      let sending = false;
      form.addEventListener('submit', (e) => {
        // One request per click: a double click must not open WhatsApp twice or post twice.
        if (sending) { e.preventDefault(); return; }
        sending = true;
        button?.setAttribute('aria-disabled', 'true');
        window.setTimeout(() => { sending = false; button?.removeAttribute('aria-disabled'); }, 4000);
        if (form.dataset.mode !== 'whatsapp') return;
        e.preventDefault();
        const honeypot = form.elements.namedItem('_gotcha');
        if (honeypot instanceof HTMLInputElement && honeypot.value) return;
        const lines = [form.dataset.intro ?? ''];
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-label]').forEach((el) => {
          let v = (el.value || '').trim();
          if (el instanceof HTMLSelectElement) v = el.value ? el.options[el.selectedIndex].text : '';
          if (v) lines.push(`${el.dataset.label}: ${v}`);
        });
        if (status) status.textContent = form.dataset.opening ?? '';
        window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
      });
    }
  </script>
</BaseLayout>
