---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroShots from '../../components/HeroShots.astro';
import AiShowcase from '../../components/AiShowcase.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, type Lang } from '../../content/types';
import { products, productList } from '../../content';
import { home } from '../../content/pages';
import { t } from '../../i18n/ui';
import { path } from '../../lib/routes';
import { pageGraph } from '../../lib/seo';
import { abs } from '../../lib/routes';
import { whatsappLink } from '../../config/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const h = home[lang];
const og = `/og/og-home-${lang}.png`;
// Comparison table column headings (product names, the same in both languages).
const columns = ['Genoa', 'Genoa Gov'];
// Row-header icons of the comparison table, beside the row labels.
const rowIcons = { for: 'users', modules: 'box', distinctive: 'spark', more: 'arrow' } as const;
const jsonld = pageGraph({
  lang,
  pathname: path(lang),
  title: h.title,
  description: h.description,
  about: ['companies', 'government'],
  image: abs(og),
});
---
<BaseLayout lang={lang} title={h.title} description={h.description} ogImage={og} jsonld={jsonld}>
  <section class="page-hero home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Genoa Systems</span>
        <h1>{h.h1}</h1>
        {/* The answer in its three parts (see HomeAnswer): the lead, the buttons, then one block per product. */}
        <p class="answer answer-lead">{h.answerParts.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={path(lang, 'contact')}>{t('bookDemo', lang)}</a>
          <a class="btn btn-wa" href={whatsappLink(t('whatsappPrefill', lang))} rel="noopener" target="_blank"><Icon name="whatsapp" />{t('whatsapp', lang)}</a>
        </div>
        <div class="answer-products">
          {productList.map((p) => (
            <div class="answer-product" data-product={p.id}>
              <span class="product-chip">{p.id === 'companies' ? t('companies', lang) : t('government', lang)}</span>
              <p class="answer">{h.answerParts[p.id]}</p>
            </div>
          ))}
        </div>
      </div>
      <HeroShots lang={lang} />
    </div>
    <div class="container">
      <ul class="highlights">
        {h.highlights.map((x, i) => <li style={`--i:${i}`}><Icon name="check" />{x}</li>)}
      </ul>
    </div>
  </section>

  <div class="section home-products">
    <div class="container product-split">
      {productList.map((p) => {
        const card = h.products[p.id];
        return (
          <section class="product-card" data-product={p.id} aria-labelledby={`what-${p.id}`} data-reveal style={`--i:${p.id === 'companies' ? 0 : 1}`}>
            <span class="tag">{p.id === 'companies' ? t('companies', lang) : t('government', lang)}</span>
            <h2 id={`what-${p.id}`}>{card.heading}</h2>
            <p>{card.body}</p>
            <ul class="module-links">
              {p.features.map((f) => (
                <li>
                  <a href={path(lang, p.id, f.slug)}>
                    <Icon name={f.icon} />
                    <span>{f.content[lang].navLabel}</span>
                    {f.optional && <span class="badge-optional">{t('optionalBadge', lang)}</span>}
                    {f.ai && <span class="badge-ai"><Icon name="spark" />{t('aiBadge', lang)}</span>}
                  </a>
                </li>
              ))}
            </ul>
            <a class="btn btn-primary" href={path(lang, p.id)}>{card.cta}</a>
          </section>
        );
      })}
    </div>
  </div>

  <AiShowcase lang={lang} />

  {/* The two screenshots are in the hero now: this points to each product's own screens. */}
  <section class="section screens-note-section" aria-labelledby="inside-heading">
    <div class="container">
      <div class="screens-note" data-reveal>
        <div>
          <h2 id="inside-heading">{t('galleryHeading', lang)}</h2>
          <p>{t('galleryMore', lang)}</p>
        </div>
        <div class="btn-row">
          {productList.map((p) => (
            <a class="btn btn-ghost" href={`${path(lang, p.id)}#gallery-heading`}>{p.id === 'companies' ? t('screensGenoa', lang) : t('screensGov', lang)}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="compare-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="compare-heading">{h.compare.heading}</h2>
        <p>{h.compare.intro}</p>
      </div>
      <div class="table-wrap" data-reveal role="region" aria-labelledby="compare-heading" tabindex="0">
        {/* --label-n: the column headings, shown in each cell when a narrow table is stacked as cards. */}
        <table class="compare" style={`--label-2: "${columns[0]}"; --label-3: "${columns[1]}"`}>
          <thead>
            <tr>
              <td></td>
              <th scope="col" data-product="companies">{columns[0]}</th>
              <th scope="col" data-product="government">{columns[1]}</th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row"><Icon name={rowIcons.for} />{h.compare.rowLabels.for}</th><td>{h.compare.genoa.for}</td><td>{h.compare.gov.for}</td></tr>
            <tr><th scope="row"><Icon name={rowIcons.modules} />{h.compare.rowLabels.modules}</th><td>{h.compare.genoa.modules}</td><td>{h.compare.gov.modules}</td></tr>
            <tr><th scope="row"><Icon name={rowIcons.distinctive} />{h.compare.rowLabels.distinctive}</th><td>{h.compare.genoa.distinctive}</td><td>{h.compare.gov.distinctive}</td></tr>
            <tr>
              <th scope="row"><Icon name={rowIcons.more} class="flip-rtl" />{h.compare.rowLabels.more}</th>
              <td><a href={path(lang, 'companies')}>{t('companies', lang)}</a></td>
              <td><a href={path(lang, 'government')}>{t('government', lang)}</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <div class="container">
      <h2 id="principles-heading" class="ruled" data-reveal>{h.principles.heading}</h2>
      <div class="principles">
        {h.principles.items.map((it, i) => (
          <div data-reveal style={`--i:${i}`}>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section section-soft">
    <div class="container product-split">
      <section class="product-card" aria-labelledby="security-heading" data-reveal>
        <span class="card-icon" aria-hidden="true"><Icon name="shield" /></span>
        <h2 id="security-heading">{h.security.heading}</h2>
        <p>{h.security.body}</p>
        <a class="btn btn-ghost" href={path(lang, 'security-backups')}><Icon name="shield" />{h.security.link}</a>
      </section>
      <section class="product-card" aria-labelledby="faq-heading" data-reveal style="--i:1">
        <span class="card-icon" aria-hidden="true"><Icon name="book" /></span>
        <h2 id="faq-heading">{h.faq.heading}</h2>
        <p>{h.faq.body}</p>
        <ul class="module-links">
          {productList.map((p) => (
            <li><a href={path(lang, p.id, 'faq')}><Icon name="book" /><span>{products[p.id].faq[lang].h1}</span></a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <CtaBand lang={lang} />
</BaseLayout>
