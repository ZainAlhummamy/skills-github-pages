---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroLedger from '../../components/HeroLedger.astro';
import Screenshot from '../../components/Screenshot.astro';
import { hasRealScreenshot } from '../../content/screenshots';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, type Lang } from '../../content/types';
import { products, productList } from '../../content';
import { home } from '../../content/pages';
import { t } from '../../i18n/ui';
import { path } from '../../lib/routes';
import { pageGraph } from '../../lib/seo';
import { abs } from '../../lib/routes';
import { whatsappLink } from '../../config/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const h = home[lang];
const og = `/og/og-home-${lang}.png`;
// Real screenshots for the 'inside the software' pair (shown only when both exist).
const insideIds = ['companies-overview', hasRealScreenshot('government-vouchers-approval') ? 'government-vouchers-approval' : 'government-overview'];
const showInside = insideIds.every(hasRealScreenshot);
const jsonld = pageGraph({
  lang,
  pathname: path(lang),
  title: h.title,
  description: h.description,
  about: ['companies', 'government'],
  image: abs(og),
});
---
<BaseLayout lang={lang} title={h.title} description={h.description} ogImage={og} jsonld={jsonld}>
  <section class="page-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Genoa Systems</span>
        <h1>{h.h1}</h1>
        <p class="answer">{h.answer}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={path(lang, 'contact')}>{t('bookDemo', lang)}</a>
          <a class="btn btn-wa" href={whatsappLink(t('whatsappPrefill', lang))} rel="noopener" target="_blank"><Icon name="whatsapp" />{t('whatsapp', lang)}</a>
        </div>
        <ul class="highlights">
          {h.highlights.map((x, i) => <li style={`--i:${i}`}><Icon name="check" />{x}</li>)}
        </ul>
      </div>
      <HeroLedger lang={lang} />
    </div>
  </section>

  <div class="section">
    <div class="container product-split">
      {productList.map((p) => {
        const card = h.products[p.id];
        return (
          <section class="product-card" data-product={p.id} aria-labelledby={`what-${p.id}`} data-reveal style={`--i:${p.id === 'companies' ? 0 : 1}`}>
            <span class="tag">{p.id === 'companies' ? t('companies', lang) : t('government', lang)}</span>
            <h2 id={`what-${p.id}`}>{card.heading}</h2>
            <p>{card.body}</p>
            <ul class="module-links">
              {p.features.map((f) => (
                <li>
                  <a href={path(lang, p.id, f.slug)}>
                    <Icon name={f.icon} />
                    <span>{f.content[lang].navLabel}</span>
                    {f.optional && <span class="badge-optional">{t('optionalBadge', lang)}</span>}
                  </a>
                </li>
              ))}
            </ul>
            <a class="btn btn-primary" href={path(lang, p.id)}>{card.cta}</a>
          </section>
        );
      })}
    </div>
  </div>

  {showInside && (
    <section class="section section-soft" aria-labelledby="inside-heading">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 id="inside-heading">{t('galleryHeading', lang)}</h2>
          <p>{t('galleryIntro', lang)}</p>
        </div>
        <div class="inside-grid">
          {insideIds.map((id, i) => {
            const pid = id.startsWith('companies') ? 'companies' : 'government';
            return (
              <div data-reveal style={`--i:${i}`}>
                <h3><a href={path(lang, pid)}>{pid === 'companies' ? t('companies', lang) : t('government', lang)}</a></h3>
                <Screenshot lang={lang} id={id} alt="" caption="" />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section" style={showInside ? undefined : 'padding-top:0'} aria-labelledby="tech-heading">
    <div class="container">
      <div class="tech-card" data-reveal>
        <span class="tech-icon"><Icon name="spark" /></span>
        <div>
          <h2 id="tech-heading">{h.tech.heading}</h2>
          {h.tech.body.map((p) => <p>{p}</p>)}
          <a class="btn btn-primary" href={path(lang, 'contact')}>{h.tech.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="compare-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="compare-heading">{h.compare.heading}</h2>
        <p>{h.compare.intro}</p>
      </div>
      <div class="table-wrap" data-reveal role="region" aria-labelledby="compare-heading" tabindex="0">
        <table class="compare">
          <thead>
            <tr>
              <td></td>
              <th scope="col">Genoa</th>
              <th scope="col">Genoa Gov</th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">{h.compare.rowLabels.for}</th><td>{h.compare.genoa.for}</td><td>{h.compare.gov.for}</td></tr>
            <tr><th scope="row">{h.compare.rowLabels.modules}</th><td>{h.compare.genoa.modules}</td><td>{h.compare.gov.modules}</td></tr>
            <tr><th scope="row">{h.compare.rowLabels.distinctive}</th><td>{h.compare.genoa.distinctive}</td><td>{h.compare.gov.distinctive}</td></tr>
            <tr>
              <th scope="row">{h.compare.rowLabels.more}</th>
              <td><a href={path(lang, 'companies')}>{t('companies', lang)}</a></td>
              <td><a href={path(lang, 'government')}>{t('government', lang)}</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <div class="container">
      <h2 id="principles-heading" class="ruled" data-reveal>{h.principles.heading}</h2>
      <div class="principles">
        {h.principles.items.map((it, i) => (
          <div data-reveal style={`--i:${i}`}>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section section-soft">
    <div class="container product-split">
      <section class="product-card" aria-labelledby="security-heading" data-reveal>
        <h2 id="security-heading">{h.security.heading}</h2>
        <p>{h.security.body}</p>
        <a class="btn btn-ghost" href={path(lang, 'security-backups')}><Icon name="shield" />{h.security.link}</a>
      </section>
      <section class="product-card" aria-labelledby="faq-heading" data-reveal style="--i:1">
        <h2 id="faq-heading">{h.faq.heading}</h2>
        <p>{h.faq.body}</p>
        <ul class="module-links">
          {productList.map((p) => (
            <li><a href={path(lang, p.id, 'faq')}><Icon name="book" /><span>{products[p.id].faq[lang].h1}</span></a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <CtaBand lang={lang} />
</BaseLayout>
