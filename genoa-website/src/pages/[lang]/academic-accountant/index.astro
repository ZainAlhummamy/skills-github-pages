---
/**
 * Academic Accountant hub: who the office is, where it is, what it offers, and how it relates to Genoa Systems.
 * Copy: src/content/academic-accountant.ts. Styles: src/styles/academic-accountant.css (scoped to .aa).
 */
import '../../../styles/academic-accountant.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AnswerBox from '../../../components/AnswerBox.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import FaqList from '../../../components/FaqList.astro';
import Icon from '../../../components/Icon.astro';
import AaLogo from '../../../components/aa/AaLogo.astro';
import AaConsultation from '../../../components/aa/AaConsultation.astro';
import AaContact from '../../../components/aa/AaContact.astro';
import { LANGS, type Lang } from '../../../content/types';
import { aaContactBlock, aaHub } from '../../../content/academic-accountant';
import { t } from '../../../i18n/ui';
import { abs, path } from '../../../lib/routes';
import { ids, pageGraph } from '../../../lib/seo';
import { aaLogoForSchema } from '../../../lib/aa-logo';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = aaHub[lang];
const pathname = path(lang, 'academic-accountant');
const services = path(lang, 'academic-accountant', 'services');
const crumbs = [
  { name: t('home', lang), href: path(lang) },
  { name: c.navLabel, href: pathname },
];
const og = `/og/og-academic-accountant-${lang}.png`;
const jsonld = pageGraph({
  lang,
  pathname,
  title: c.title,
  description: c.description,
  breadcrumbs: crumbs,
  subject: 'academic-accountant',
  aaLogo: await aaLogoForSchema(),
  // Genoa Systems and its products are mentioned (section "Accounting systems"); the page is about the office.
  mentions: [ids.org, ids.product('companies'), ids.product('government')],
  faqs: c.faqs,
  image: abs(og),
});
---
<BaseLayout lang={lang} title={c.title} description={c.description} ogImage={og} ogImageAlt={c.h1} jsonld={jsonld}>
  <div class="aa">
    <section class="page-hero">
      <div class="container">
        <Breadcrumbs lang={lang} items={crumbs} />
        <div class="aa-hero-grid">
          <div>
            <span class="eyebrow">{c.eyebrow}</span>
            <h1>{c.h1}</h1>
            <AnswerBox lang={lang} text={c.answer} />
            <div class="btn-row">
              <a class="btn btn-primary" href={services}>{c.whatWeDo.allServices}</a>
              <a class="btn btn-ghost" href="#aa-contact"><Icon name="phone" />{aaContactBlock[lang].jump}</a>
            </div>
          </div>
          <AaLogo lang={lang} />
        </div>
      </div>
    </section>

    <div class="section">
      <div class="container">
        <KeyFacts lang={lang} facts={c.keyFacts} />
      </div>
    </div>

    <section class="section section-soft" aria-labelledby="what-we-do">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 id="what-we-do">{c.whatWeDo.heading}</h2>
          <p>{c.whatWeDo.intro}</p>
        </div>
        <ul class="cards">
          {c.whatWeDo.cards.map((card, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <div class="card">
                <span class="icon"><Icon name={card.icon} /></span>
                <h3><a href={`${services}#${card.group}`}>{card.title}</a></h3>
                <p>{card.body}</p>
                <span class="more" aria-hidden="true">{t('learnMore', lang)} <Icon name="arrow" class="flip-rtl" /></span>
              </div>
            </li>
          ))}
        </ul>
        <p style="margin-top:1.5rem"><a class="btn btn-primary" href={services}>{c.whatWeDo.allServices}</a></p>
      </div>
    </section>

    <div class="section">
      <div class="container article prose">
        <section aria-labelledby="training" data-reveal>
          <h2 id="training">{c.training.heading}</h2>
          {c.training.body.map((p) => <p>{p}</p>)}
        </section>
        <section aria-labelledby="systems" data-reveal>
          <h2 id="systems">{c.systems.heading}</h2>
          <p>{c.systems.intro}</p>
          <ul class="aa-systems">
            <li><a href={path(lang, 'companies')}>{t('companies', lang)}</a>: {c.systems.genoa}</li>
            <li><a href={path(lang, 'government')}>{t('government', lang)}</a>: {c.systems.genoaGov}</li>
          </ul>
          <p>{c.systems.demoLead} <a href={path(lang, 'contact')}>{c.systems.demoLink}</a>.</p>
        </section>
      </div>
    </div>

    <AaConsultation lang={lang} />

    <div class="section" style="padding-top:0">
      <div class="container">
        <AaContact lang={lang} />
      </div>
    </div>

    <section class="section section-soft" aria-labelledby="aa-faq">
      <div class="container prose">
        <h2 id="aa-faq" class="ruled" data-reveal>{c.faqHeading}</h2>
        <FaqList faqs={c.faqs} idPrefix="aa-q" />
      </div>
    </section>
  </div>
</BaseLayout>
